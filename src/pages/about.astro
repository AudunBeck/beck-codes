---
import PageLayout from "@/layouts/Base.astro";

import { getCv } from "@/lib/sifaProfile.ts";

const meta = {
  title: "About",
};
const cv = await getCv();
---

<PageLayout meta={meta}>
  <h1 class="title mb-8">/about</h1>
  <div class="prose prose-sm prose-cactus max-w-none">
    <p>Software Engineer, {" "} <em class="text-accent italic"> and full-time nerd.</em></p>
    <p>
      I work as a webdev, focusing on the full experience of the technical stack.
      <br />
      Starting at the development team's workflow and choice of tech.
    </p>
    <p>
      I'm a senior consultant at{" "}
      <a href="https://www.netlight.com/" class="text-accent" rel="noreferrer" target="_blank"
        >Netlight</a
      >
      , a consultancy that focuses on learning and collective intelligence in the technology
      industry.
    </p>
    <p>
      When I don't work, I enjoy spending my time tinkering with software, play board games and
      tabletop rpgs.
      <br />I do also read a lot, and sometimes write.
    </p>
  </div>
  <section class="mt-16">
    <h2 class="title mb-4">Experience</h2>
    <ol>
      {cv.positions?.map(position => (
      <li class="flex gap-4">
        <div class="flex flex-col items-center">
            <div class="size-2.5 mt-2 border-accent border-2 rounded-full"/>
            <div class="w-px grow border border-accent/15"/>
            </div>
            <div class="flex-1 pb-6">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
                <h3 class="title text-xl">{position.title}</h3>
                <span class="text-muted">
                  {position.startedAt} - {position.endedAt || "Present"}
                </span>
              </div>
              <div>
               <span class="block text-muted mb-2">{position.company}</span>
               <span class="whitespace-pre-wrap">{position.description}</span>
              </div>
            </div>
        </li>
    ))}
    </ol>
  </section>
</PageLayout>
